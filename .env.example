# BirthdayWisher configuration.
#
# BACKEND (copy these into backend/.env, see backend/.env.example for the same list):
PORT=8787
ALLOWED_ORIGINS=https://YOUR-USERNAME.github.io,http://localhost:5500
PUBLIC_API_URL=https://YOUR-BACKEND.example.com
DB_PATH=./data/bw.sqlite
UPLOAD_DIR=./storage
CRON_SECRET=change-me-long-random
CLEANUP_INTERVAL_MS=60000
# PUBLISH_LIMIT=10          # publishes per hour per IP

# FRONTEND has no .env (it is static). Its API URL is set in js/config.js:
#   - localhost / 127.0.0.1  -> http://localhost:8787
#   - anything else          -> the URL in js/config.js (edit YOUR-BACKEND.example.com),
#     or define window.BW_API_URL before the page's scripts run.
